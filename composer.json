{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "pgs/laravel-ai-chatbot",
    "description": "Reusable, application-agnostic AI chatbot foundations for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/ai": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Pgs\\LaravelAiChatbot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pgs\\LaravelAiChatbot\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pgs\\LaravelAiChatbot\\AiChatbotServiceProvider"
            ],
            "aliases": {
                "AiChatbot": "Pgs\\LaravelAiChatbot\\Facades\\AiChatbot"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
